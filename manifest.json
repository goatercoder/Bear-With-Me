{
  "manifest_version": 3,
  "name": "Oski — don't let him die",
  "version": "2.0.0",
  "description": "A tiny 8-bit Oski sits in the top-right corner. Go idle or doomscroll YouTube, Instagram, Reddit, Twitter or Clash Royale and he slowly gets torn apart. Keep working and he heals.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Oski — click to start (and to bring him back)",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["rules.js", "background.js"]
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["oski.js", "overlay.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "permissions": ["storage", "alarms", "tabs", "idle", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "focusling@goatercoder.github.io", "strict_min_version": "121.0" } }
}
