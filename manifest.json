{
  "manifest_version": 3,
  "name": "Focusling — Study Pet",
  "version": "1.0.0",
  "description": "A pixel pet that fights aliens while you study. Pomodoro timer, XP, levels and a pet that starves if you slack off.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focusling — your study pet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["core.js", "background.js"]
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "focusling@goatercoder.github.io",
      "strict_min_version": "121.0"
    }
  }
}
